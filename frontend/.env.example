# Browser development (default uses Vite proxy with /api)
# VITE_API_BASE_URL=/api

# Direct backend URL for emulator / APK / real phone testing.
# Android Emulator -> use 10.0.2.2 for host machine loopback.
# VITE_API_BASE_URL=http://10.0.2.2:8080/api

# Real phone in same LAN -> replace with your PC LAN IP.
# VITE_API_BASE_URL=http://192.168.1.100:8080/api

# Optional Vite dev proxy target (used only when VITE_API_BASE_URL is /api or empty)
# VITE_PROXY_TARGET=http://localhost:8080
